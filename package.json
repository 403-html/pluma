{
  "name": "pluma",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "scripts": {
    "app:dev": "pnpm --filter @pluma-flags/app dev",
    "api:dev": "pnpm --filter @pluma-flags/api dev",
    "docs:dev": "pnpm --filter @pluma-flags/docs dev",
    "docs:build": "pnpm --filter @pluma-flags/docs build",
    "build": "pnpm -r build",
    "build:esbuild": "node tooling/esbuild/build.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "test": "pnpm -r test",
    "storybook": "pnpm --filter @pluma-flags/storybook dev",
    "build-storybook": "pnpm --filter @pluma-flags/storybook build"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "4.18.1",
      "defu": "6.1.6",
      "@xmldom/xmldom": "0.9.9",
      "picomatch@^2.3.1": "2.3.2",
      "picomatch@^4.0.3": "4.0.4",
      "picomatch@^3 || ^4": "4.0.4",
      "yaml": "2.8.3"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "10.3.1",
    "globals": "^17.4.0",
    "prettier": "3.8.1"
  }
}
